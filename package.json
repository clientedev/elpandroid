{
  "name": "elp-android",
  "version": "1.0.9",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-media-library": "~57.0.5",
    "expo-print": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.24",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node -e \"try{require('child_process').execSync('pip install -r requirements.txt',{stdio:'ignore'})}catch(e){}\"",
    "start": "node -e \"if(process.env.RAILWAY_ENVIRONMENT||process.env.PORT||process.platform==='linux'){require('child_process').spawn('bash',['start.sh'],{stdio:'inherit'})}else{require('child_process').spawn('npx',['expo','start'],{stdio:'inherit',shell:true})}\"",
    "expo": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1"
  },
  "private": true
}
